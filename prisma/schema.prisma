// Multi-tenant schema. Every tenant-owned table carries organizationId.
// Tables marked "RLS" are protected by PostgreSQL Row Level Security
// (see the init migration) and must be accessed through tenantDb() or systemDb().

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ACCOUNTANT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  locale          String    @default("en")
  /// Verified mobile in E.164 (+9665XXXXXXXX). Unique: one phone number is one account.
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  /// Number entered at sign-up, not yet verified. Not unique, so nobody can block a number they do not own.
  pendingPhone    String?
  /// End of this account's free trial; set when the first company is created.
  trialEndsAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   Membership[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  phoneCodes    PhoneVerificationCode[]
  organizations Organization[]          @relation("OrganizationCreatedBy")

  @@map("users")
}

model Session {
  id                   String   @id @default(cuid())
  tokenHash            String   @unique
  userId               String
  activeOrganizationId String?
  expiresAt            DateTime
  lastSeenAt           DateTime @default(now())
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Organization {
  id               String    @id @default(cuid())
  nameEn           String
  nameAr           String?
  crNumber         String?
  vatNumber        String?
  addressLine      String?
  city             String?
  postalCode       String?
  country          String    @default("SA")
  currency         String    @default("SAR")
  bankName         String?
  bankAccountName  String?
  iban             String?
  setupCompletedAt DateTime?
  archivedAt       DateTime?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdBy    User              @relation("OrganizationCreatedBy", fields: [createdById], references: [id])
  memberships  Membership[]
  invitations  Invitation[]
  subscription Subscription?
  auditLogs    AuditLog[]
  logo         OrganizationLogo?
  clients      Client[]
  sites        Site[]
  workers      Worker[]

  @@map("organizations")
}

model OrganizationLogo {
  organizationId String   @id
  data           Bytes
  mimeType       String
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_logos")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// RLS
model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitations")
}

/// RLS
model Subscription {
  id               String             @id @default(cuid())
  organizationId   String             @unique
  status           SubscriptionStatus
  planCode         String?
  billingCycle     BillingCycle?
  trialEndsAt      DateTime
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// RLS
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@map("rate_limits")
}

model PhoneVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  phone     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("phone_verification_codes")
}

/// One free trial per phone number and per email, kept even if an account is removed later.
model TrialClaim {
  id        String   @id @default(cuid())
  phone     String   @unique
  email     String   @unique
  userId    String
  createdAt DateTime @default(now())

  @@map("trial_claims")
}

/// RLS. A customer of the company (the party invoices are issued to).
model Client {
  id             String    @id @default(cuid())
  organizationId String
  nameEn         String
  nameAr         String?
  vatNumber      String?
  crNumber       String?
  contactName    String?
  phone          String?
  email          String?
  addressLine    String?
  city           String?
  postalCode     String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sites        Site[]

  @@unique([id, organizationId])
  @@index([organizationId, archivedAt])
  @@map("clients")
}

/// RLS. A work location of a client. The composite foreign key keeps a site in its client's organization.
model Site {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  city           String?
  address        String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId])
  workers      Worker[]

  @@unique([id, organizationId])
  @@index([organizationId, archivedAt])
  @@index([clientId])
  @@map("sites")
}

/// RLS. A worker. Iqama and passport numbers are encrypted at rest (AES-256-GCM);
/// the hash is a keyed HMAC used for duplicate checks and exact search, the last 4 digits for masked display.
model Worker {
  id                 String    @id @default(cuid())
  organizationId     String
  name               String
  nameAr             String?
  iqamaEncrypted     String
  iqamaHash          String
  iqamaLast4         String
  nationality        String?
  jobTitle           String?
  phone              String?
  /// Monthly amounts in halalas (1 SAR = 100 halalas).
  basicSalary        Int       @default(0)
  housingAllowance   Int       @default(0)
  transportAllowance Int       @default(0)
  otherAllowance     Int       @default(0)
  siteId             String?
  iqamaExpiry        DateTime? @db.Date
  passportEncrypted  String?
  passportLast4      String?
  passportExpiry     DateTime? @db.Date
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId, organizationId], references: [id, organizationId])

  @@unique([organizationId, iqamaHash])
  @@index([organizationId, archivedAt])
  @@index([organizationId, iqamaExpiry])
  @@index([organizationId, passportExpiry])
  @@index([siteId])
  @@map("workers")
}
