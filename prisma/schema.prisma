// Multi-tenant schema. Every tenant-owned table carries organizationId.
// Tables marked "RLS" are protected by PostgreSQL Row Level Security
// (see the init migration) and must be accessed through tenantDb() or systemDb().

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ACCOUNTANT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SalesDocType {
  QUOTATION
  PROFORMA
  INVOICE
  CREDIT_NOTE
}

/// Stored state only. Payment state (partial, paid, overdue) is derived from amounts and dates.
enum SalesDocStatus {
  DRAFT
  SENT
}

enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

enum FinanceKind {
  INCOME
  EXPENSE
}

/// Where a finance entry comes from. Only MANUAL entries are edited on the finance pages;
/// the others follow their source (invoice payment, refund on a credited invoice, approved salary sheet).
enum FinanceSource {
  MANUAL
  INVOICE_PAYMENT
  INVOICE_REFUND
  SALARY_SHEET
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  OTHER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  locale          String    @default("en")
  /// Verified mobile in E.164 (+9665XXXXXXXX). Unique: one phone number is one account.
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  /// Number entered at sign-up, not yet verified. Not unique, so nobody can block a number they do not own.
  pendingPhone    String?
  /// End of this account's free trial; set when the first company is created.
  trialEndsAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   Membership[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  phoneCodes    PhoneVerificationCode[]
  organizations Organization[]          @relation("OrganizationCreatedBy")

  @@map("users")
}

model Session {
  id                   String   @id @default(cuid())
  tokenHash            String   @unique
  userId               String
  activeOrganizationId String?
  expiresAt            DateTime
  lastSeenAt           DateTime @default(now())
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Organization {
  id               String    @id @default(cuid())
  nameEn           String
  nameAr           String?
  crNumber         String?
  vatNumber        String?
  addressLine      String?
  city             String?
  postalCode       String?
  country          String    @default("SA")
  currency         String    @default("SAR")
  bankName         String?
  bankAccountName  String?
  iban             String?
  setupCompletedAt DateTime?
  archivedAt       DateTime?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdBy         User                @relation("OrganizationCreatedBy", fields: [createdById], references: [id])
  memberships       Membership[]
  invitations       Invitation[]
  subscription      Subscription?
  auditLogs         AuditLog[]
  logo              OrganizationLogo?
  clients           Client[]
  sites             Site[]
  workers           Worker[]
  salesDocs         SalesDocument[]
  salesLines        SalesDocumentLine[]
  payments          SalesPayment[]
  docCounters       DocumentCounter[]
  financeCategories FinanceCategory[]
  financeEntries    FinanceEntry[]

  @@map("organizations")
}

model OrganizationLogo {
  organizationId String   @id
  data           Bytes
  mimeType       String
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_logos")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// RLS
model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitations")
}

/// RLS
model Subscription {
  id               String             @id @default(cuid())
  organizationId   String             @unique
  status           SubscriptionStatus
  planCode         String?
  billingCycle     BillingCycle?
  trialEndsAt      DateTime
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// RLS
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@map("rate_limits")
}

model PhoneVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  phone     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("phone_verification_codes")
}

/// One free trial per phone number and per email, kept even if an account is removed later.
model TrialClaim {
  id        String   @id @default(cuid())
  phone     String   @unique
  email     String   @unique
  userId    String
  createdAt DateTime @default(now())

  @@map("trial_claims")
}

/// RLS. A customer of the company (the party invoices are issued to).
model Client {
  id             String    @id @default(cuid())
  organizationId String
  nameEn         String
  nameAr         String?
  vatNumber      String?
  crNumber       String?
  contactName    String?
  phone          String?
  email          String?
  addressLine    String?
  city           String?
  postalCode     String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sites          Site[]
  salesDocs      SalesDocument[]
  financeEntries FinanceEntry[]

  @@unique([id, organizationId])
  @@index([organizationId, archivedAt])
  @@map("clients")
}

/// RLS. A work location of a client. The composite foreign key keeps a site in its client's organization.
model Site {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  city           String?
  address        String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId, organizationId], references: [id, organizationId])
  workers        Worker[]
  salesDocs      SalesDocument[]
  financeEntries FinanceEntry[]

  @@unique([id, organizationId])
  @@index([organizationId, archivedAt])
  @@index([clientId])
  @@map("sites")
}

/// RLS. A worker. Iqama and passport numbers are encrypted at rest (AES-256-GCM);
/// the hash is a keyed HMAC used for duplicate checks and exact search, the last 4 digits for masked display.
model Worker {
  id                 String    @id @default(cuid())
  organizationId     String
  name               String
  nameAr             String?
  iqamaEncrypted     String
  iqamaHash          String
  iqamaLast4         String
  nationality        String?
  jobTitle           String?
  phone              String?
  /// Monthly amounts in halalas (1 SAR = 100 halalas).
  basicSalary        Int       @default(0)
  housingAllowance   Int       @default(0)
  transportAllowance Int       @default(0)
  otherAllowance     Int       @default(0)
  siteId             String?
  iqamaExpiry        DateTime? @db.Date
  passportEncrypted  String?
  passportLast4      String?
  passportExpiry     DateTime? @db.Date
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId, organizationId], references: [id, organizationId])

  @@unique([organizationId, iqamaHash])
  @@index([organizationId, archivedAt])
  @@index([organizationId, iqamaExpiry])
  @@index([organizationId, passportExpiry])
  @@index([siteId])
  @@map("workers")
}

/// RLS. Last number used per company and document type (QT-, PI-, INV- series).
model DocumentCounter {
  organizationId String
  type           SalesDocType
  lastNumber     Int          @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, type])
  @@map("document_counters")
}

/// RLS. Quotation, proforma invoice or tax invoice. Amounts are integer halalas, computed on the server.
/// Quotations and proformas are numbered when created; tax invoices only when issued (no gaps).
/// An issued tax invoice (status SENT) can no longer be edited or deleted.
model SalesDocument {
  id                String         @id @default(cuid())
  organizationId    String
  type              SalesDocType
  status            SalesDocStatus @default(DRAFT)
  /// Null for a draft tax invoice.
  number            String?
  clientId          String
  siteId            String?
  /// The quotation or proforma this was converted from. Unique: a document converts once.
  sourceId          String?        @unique
  /// For a credit note: the issued tax invoice it corrects.
  creditedInvoiceId String?
  /// For a credit note: why the invoice is corrected (required on credit notes).
  reason            String?
  issueDate         DateTime       @db.Date
  /// Due date for invoices, "valid until" for quotations.
  dueDate           DateTime?      @db.Date
  /// Exact moment a tax invoice was issued (used in the ZATCA QR code).
  issuedAt          DateTime?
  /// Seller and buyer details frozen on the document (company or client edits do not change old documents).
  seller            Json
  buyer             Json
  discountType      DiscountType   @default(NONE)
  /// Basis points for PERCENT (1000 = 10%), halalas for AMOUNT.
  discountValue     Int            @default(0)
  /// Basis points (1500 = 15%).
  vatRate           Int
  subtotal          Int
  discountAmount    Int
  taxableAmount     Int
  vatAmount         Int
  total             Int
  paidAmount        Int            @default(0)
  /// Invoices: total of issued credit notes against it.
  creditedAmount    Int            @default(0)
  /// max(0, total - paidAmount - creditedAmount); kept by the database check.
  balance           Int            @default(0)
  notes             String?
  terms             String?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client              @relation(fields: [clientId, organizationId], references: [id, organizationId])
  site            Site?               @relation(fields: [siteId, organizationId], references: [id, organizationId])
  source          SalesDocument?      @relation("Conversion", fields: [sourceId], references: [id])
  convertedTo     SalesDocument?      @relation("Conversion")
  creditedInvoice SalesDocument?      @relation("CreditNotes", fields: [creditedInvoiceId, organizationId], references: [id, organizationId])
  creditNotes     SalesDocument[]     @relation("CreditNotes")
  lines           SalesDocumentLine[]
  payments        SalesPayment[]
  financeEntries  FinanceEntry[]

  @@unique([id, organizationId])
  @@unique([organizationId, type, number])
  @@index([organizationId, type, createdAt])
  @@index([organizationId, type, status, dueDate])
  @@index([clientId])
  @@index([siteId])
  @@index([creditedInvoiceId])
  @@map("sales_documents")
}

/// RLS. A line of a sales document.
model SalesDocumentLine {
  id             String  @id @default(cuid())
  organizationId String
  documentId     String
  position       Int
  description    String
  descriptionAr  String?
  /// Thousandths (1500 = 1.5), so hours or days can have decimals without floats.
  quantity       Int
  /// Halalas, excluding VAT.
  unitPrice      Int
  /// round(quantity x unitPrice), halalas, excluding VAT.
  lineTotal      Int

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     SalesDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([documentId, position])
  @@map("sales_document_lines")
}

/// RLS. A payment received against an issued tax invoice.
model SalesPayment {
  id             String        @id @default(cuid())
  organizationId String
  documentId     String
  /// Halalas, including VAT.
  amount         Int
  paidOn         DateTime      @db.Date
  method         PaymentMethod
  reference      String?
  note           String?
  createdById    String?
  createdAt      DateTime      @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     SalesDocument @relation(fields: [documentId, organizationId], references: [id, organizationId])
  financeEntry FinanceEntry?

  @@unique([id, organizationId])
  @@index([documentId])
  @@index([organizationId, paidOn])
  @@map("sales_payments")
}

/// RLS. Income or expense category. Each company gets a default list (EN/AR) and can add its own.
/// systemKey marks the defaults the app itself uses (invoice payments, salaries); they cannot be archived.
model FinanceCategory {
  id             String      @id @default(cuid())
  organizationId String
  kind           FinanceKind
  nameEn         String
  nameAr         String?
  systemKey      String?
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      FinanceEntry[]

  @@unique([id, organizationId])
  @@unique([organizationId, kind, systemKey])
  @@index([organizationId, kind, archivedAt])
  @@map("finance_categories")
}

/// RLS. One income or expense (cash basis: the day money came in or went out).
/// amount includes VAT; vatAmount is the VAT part of it, so profit can be shown without VAT.
/// Entries are never deleted from the finance pages: a wrong manual entry is voided (kept for the audit trail).
/// An invoice payment's income entry belongs to the payment and goes away with it.
model FinanceEntry {
  id              String         @id @default(cuid())
  organizationId  String
  kind            FinanceKind
  source          FinanceSource  @default(MANUAL)
  categoryId      String
  date            DateTime       @db.Date
  /// Halalas, including VAT. Positive; kind says the direction. Only refunds (INVOICE_REFUND)
  /// are negative income, so sums and reports net them automatically.
  amount          Int
  /// Halalas, the VAT part of amount (0 when no VAT).
  vatAmount       Int            @default(0)
  description     String?
  reference       String?
  method          PaymentMethod?
  clientId        String?
  siteId          String?
  /// Set for source INVOICE_PAYMENT (one entry per payment).
  salesPaymentId  String?
  /// Set for source INVOICE_REFUND: the invoice whose money was paid back to the client.
  salesDocumentId String?
  /// Set for source SALARY_SHEET (one entry per sheet and site). Foreign key added with the salary sheet table (step 5).
  salarySheetId   String?
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category      FinanceCategory @relation(fields: [categoryId, organizationId], references: [id, organizationId])
  client        Client?         @relation(fields: [clientId, organizationId], references: [id, organizationId])
  site          Site?           @relation(fields: [siteId, organizationId], references: [id, organizationId])
  salesPayment  SalesPayment?   @relation(fields: [salesPaymentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  salesDocument SalesDocument?  @relation(fields: [salesDocumentId, organizationId], references: [id, organizationId])

  @@unique([salesPaymentId, organizationId])
  @@index([organizationId, date])
  @@index([organizationId, kind, date])
  @@index([organizationId, siteId, date])
  @@index([organizationId, salarySheetId])
  @@index([salesDocumentId])
  @@index([categoryId])
  @@map("finance_entries")
}
