# PostgreSQL connection string. The app role must NOT be a superuser,
# otherwise Row Level Security is bypassed (see DECISIONS.md).
DATABASE_URL="postgresql://nealabs:nealabs@localhost:5432/nealabs"

# Public base URL, used in password reset and invitation links.
APP_URL="http://localhost:3000"

# Email: "console" prints emails to the server log (development only).
# "smtp" sends through any SMTP provider.
EMAIL_TRANSPORT="console"
EMAIL_FROM="NeaLabs <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# SMS for phone verification codes: "console" prints codes to the server log
# (development only), "unifonic" (Saudi provider, recommended) or "twilio".
SMS_TRANSPORT="console"
UNIFONIC_APP_SID=""
UNIFONIC_SENDER_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Phone number or Messaging Service SID (starts with MG)
TWILIO_FROM=""

# Trial length in days (default 7).
TRIAL_DAYS="7"
